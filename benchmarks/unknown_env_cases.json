  {
    "id": "fields_first_native_apache",
    "benchmark_mode": "field_strategy_oracle",
    "question": "Show top Apache client IPs, status codes, methods, and user agents.",
    "expected_intent": "apache_access_top_ips",
    "sourcetype": "access_combined",
    "index_expr": "index=linux",
    "canonical_query": "search index=linux sourcetype=access_combined | rex field=_raw \"^(?<clientip>\\S+) \\S+ \\S+ \\[[^\\]]+\\] \\\"(?<method>[A-Z]+) (?<uri_path>\\S+) [^\\\"]+\\\" (?<status>\\d{3}) \\S+ \\\"[^\\\"]*\\\" \\\"(?<useragent>[^\\\"]*)\\\"\" | stats count by clientip status method useragent | sort - count",
    "role_mappings": {
      "src_ip": ["clientip"],
      "status": ["status"],
      "method": ["method"],
      "user_agent": ["useragent"]
    },
    "live_fields_by_index": {
      "linux": ["clientip", "status", "method", "useragent", "_raw"]
    },
    "expected_trusted_fields": ["clientip", "status", "method", "useragent"],
    "required_patterns": ["\\|\\s*stats count by clientip status method useragent"],
    "forbidden_patterns": ["\\|\\s*rex\\b", "\\|\\s*spath\\b"],
    "required_action_prefixes": ["removed_redundant_rex"]
  },
