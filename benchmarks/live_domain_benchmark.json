      "min_rows": 0
    },
    {
      "id": "failed_login_cross_platform_24h",
      "theme": "auth_cross",
      "question": "Show failed logon activity in the last 24 hours",
      "intent": "failed_login_activity",
      "profile_domain_hints": {
        "platform": "cross",
        "use_cases": ["failed_login_activity"],
