      },
      "expected_shape": "stats",
      "required_terms": ["4625", "Failed password", "stats"],
      "forbidden_patterns": ["linux_secure.*4625", "4625.*linux_secure"],
      "allow_zero_rows": false,
      "min_rows": 1,
