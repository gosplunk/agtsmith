FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONPATH=/app:/app/scripts

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl git make systemd \
    && rm -rf /var/lib/apt/lists/*

COPY requirements-docker.txt /tmp/requirements-docker.txt
RUN python -m pip install --upgrade pip \
    && python -m pip install -r /tmp/requirements-docker.txt

COPY . /app

ARG AGTSMITH_SOURCE_REVISION=unknown
ARG AGTSMITH_BUILD_ID=unknown

LABEL org.opencontainers.image.revision="${AGTSMITH_SOURCE_REVISION}" \
      io.agtsmith.build-id="${AGTSMITH_BUILD_ID}"

ENV AGTSMITH_IMAGE_SOURCE_REVISION="${AGTSMITH_SOURCE_REVISION}" \
    AGTSMITH_IMAGE_BUILD_ID="${AGTSMITH_BUILD_ID}"

EXPOSE 8787

CMD ["python", "scripts/web_ui_server.py", "--host", "0.0.0.0", "--port", "8787"]
