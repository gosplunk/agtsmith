# Example A.G.E.N.T. Smith runtime configuration.
# Copy to config/ui.env and replace values for the target environment.

# v1.5.x US-primary model stack — see docs/model_strategy.md and docs/runbooks/laptop_model_profile.md
OLLAMA_MODEL_QUERY_PLANNER=TechyShishy/ministral-3:3b-reasoning-2512-q4_K_M
OLLAMA_MODEL_QUERY_PLANNER_FALLBACK=ministral-3:3b
OLLAMA_MODEL_QUERY_WRITER=granite4:3b
OLLAMA_MODEL_QUERY_REPAIR=granite4:3b
OLLAMA_MODEL_EVIDENCE_REVIEWER=hf.co/fdtn-ai/Foundation-Sec-8B-Reasoning-Q8_0-GGUF:latest
OLLAMA_MODEL_SECURITY_REVIEWER=hf.co/fdtn-ai/Foundation-Sec-8B-Reasoning-Q8_0-GGUF:latest
OLLAMA_MODEL_PEER_REVIEWER=gemma3:4b
OLLAMA_MODEL_PEER_REVIEWER_2=gemma3:4b
OLLAMA_MODEL_AGENTIC_CONTINUATION_REVIEWER=hf.co/fdtn-ai/Foundation-Sec-8B-Reasoning-Q8_0-GGUF:latest
OLLAMA_MODEL_FINAL_SUMMARY=hf.co/fdtn-ai/Foundation-Sec-8B-Reasoning-Q8_0-GGUF:latest
OLLAMA_MODEL_AGENTIC_SUMMARY=hf.co/fdtn-ai/Foundation-Sec-8B-Reasoning-Q8_0-GGUF:latest

OLLAMA_AGENTIC_CONTINUATION_TIMEOUT_SEC=180
OLLAMA_AGENTIC_AUTO_CONTINUE_LIMIT=1
OLLAMA_AGENTIC_MAX_INVESTIGATION_DEPTH=3
OLLAMA_AGENTIC_CONTINUE_CONFIDENCE_THRESHOLD=0.6

OLLAMA_HOST=http://127.0.0.1:11434
# Unload models from GPU immediately after each Ollama call (0). Use 5m in production for faster back-to-back queries.
OLLAMA_KEEP_ALIVE=0

SOC_UI_AUTH_ENABLED=1
# First-run setup can create the initial user in the web UI.
# Leave the credential fields unset until first-run setup is complete.
# Optional preseeded local user store example (use a generated hash):
# SOC_UI_AUTH_USERS_JSON=[{"username":"smithadmin","password":"<password-hash>","role":"admin"}]
# SOC_UI_AUTH_USERNAME=
# SOC_UI_AUTH_PASSWORD=
SOC_UI_AUTH_ROLE=admin
SOC_UI_AUTH_INITIALIZED=0
# Idle session timeout (minutes). Session extends on each authenticated request.
SOC_UI_SESSION_TIMEOUT_MIN=60
# Longer idle timeout when the user selects Remain logged in at sign-in.
SOC_UI_SESSION_REMEMBER_TIMEOUT_MIN=480

EDGE_LLM_ENABLED=0
EDGE_LLM_HOST=
EDGE_LLM_MODEL=
EDGE_LLM_ROLE=edge_router_splitter
EDGE_LLM_TIMEOUT_SEC=60
SPLUNK_BASE_URL=https://127.0.0.1:8089
# Optional explicit Splunk Web URL override for Open In Splunk links.
# If left blank, A.G.E.N.T. Smith auto-detects Splunk Web on the same host as Splunk MCP/SPLUNK_BASE_URL
# by probing https://HOST:8000 first, then http://HOST:8000.
# SPLUNK_WEB_URL=https://127.0.0.1:8000
SPLUNK_MCP_URL=https://127.0.0.1:8089/services/mcp
SPLUNK_LAB_BEARER_TOKEN=replace-with-your-splunk-mcp-token

# SPLUNK_USER=dev
# SPLUNK_PASS=replace-with-splunk-dev-password
# SPLUNK_ADMIN_USER=admin
# SPLUNK_ADMIN_PASS=replace-with-splunk-admin-password
# Lab data generator (HTTP Event Collector) — see docs/runbooks/lab_data_generator.md
# SPLUNK_HEC_URL=https://127.0.0.1:8088/services/collector/event
# SPLUNK_HEC_TOKEN=replace-with-hec-token
# SPLUNK_HEC_INSECURE=1
# LAB_DATA_LAYOUT=existing_lab
# LAB_DATA_ENABLED=0

# Optional external case store override.
# The deployment compose stack now starts PostgreSQL automatically for case timelines.
# Override these only if you want the web UI to point at a different PostgreSQL instance.
# AGTSMITH_CASE_DB_DSN=host=127.0.0.1 port=5432 dbname=agtsmith user=agtsmith password=replace-me
# AGTSMITH_CASE_DB_HOST=127.0.0.1
# AGTSMITH_CASE_DB_PORT=5432
# AGTSMITH_CASE_DB_NAME=agtsmith
# AGTSMITH_CASE_DB_USER=agtsmith
# AGTSMITH_CASE_DB_PASSWORD=replace-me
# Splunk app mode: mirror cases locally; set AGTSMITH_KVSTORE_SYNC=1 to push to Splunk KV collections.
# AGTSMITH_CASE_BACKEND=kvstore
# AGTSMITH_KVSTORE_SYNC=0

# Optional HTTPS for the built-in web server when you provide cert and key files
# AGTSMITH_TLS_CERT_FILE=/app/certs/fullchain.pem
# AGTSMITH_TLS_KEY_FILE=/app/certs/privkey.pem

# Ollama ops monitor (Control Center -> Ollama Ops)
# Auto-detects local_systemd when journalctl can read the Ollama unit, otherwise local_docker or remote_windows.
# OLLAMA_LOG_SOURCE=local_systemd
# OLLAMA_LOG_SYSTEMD_UNIT=ollama.service
# OLLAMA_LOG_DOCKER_CONTAINER=ollama
# OLLAMA_LOG_LOCAL_CMD=journalctl -u ollama -f -n 200 --output=cat --no-pager
# OLLAMA_GPU_METRICS_CMD=nvidia-smi
# OLLAMA_LOG_REMOTE_URL=https://windows-host:8788/api/ops/ollama/logs/stream
# OLLAMA_LOG_REMOTE_TOKEN=

# Splunk Offline Docs RAG (optional; build with: make spl-offline-docs-index)
# Rebuilt automatically during: make env-profile-refresh (when scrape manifest is newer)
# AGTSMITH_TEMPLATE_OVERRIDE=always  # bypass writer LLM; use only for speed/debug (default: fallback = writer runs with few-shot gold)
# AGTSMITH_TEMPLATE_OVERRIDE=fallback
# AGTSMITH_WRITER_MODE=constrained  # constrained WritePlan slots (free = legacy raw SPL JSON)
# AGTSMITH_WRITER_MODE=constrained
# SPL_EMBEDDING_RAG_ENABLED=1
# SPL_FIELD_BIND_MCP_FALLBACK=0
# SPL_OFFLINE_DOCS_RAG_ENABLED=1
# SPL_OFFLINE_DOCS_RAG_INDEX=artifacts/knowledge/spl_offline_docs_rag_index.json
# SPL_OFFLINE_DOCS_SOURCE=/home/joehaga/ai_projects/Splunk4Offlinedocs/artifacts/staging/splunk_offline_docs/appserver/static/docs/manifest/search-index.json
